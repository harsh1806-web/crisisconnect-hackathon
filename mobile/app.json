{
  "expo": {
    "name": "CrisisConnect",
    "slug": "crisisconnect",
    "scheme": "crisisconnect",
    "owner": "harshhackathon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CrisisConnect requires GPS access to broadcast SOS beacons and display nearby evacuation perimeters.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CrisisConnect requires background location to warn you about incoming disasters."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CrisisConnect to use your location for emergency dispatch."
        }
      ]
    ],
    "android": {
      "package": "com.crisisconnect.emergency",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e11c7a72-7351-4ad5-83c7-e130816b4c6a"
      }
    }
  }
}
